{
  "schema_version": "focused-research-policy-v3",
  "minimum_variant_chains": 3,
  "minimum_distinct_source_organizations": 3,
  "maximum_source_age_days": 120,
  "maximum_consensus_age_days": 45,
  "maximum_dossier_age_days": 14,
  "maximum_catalyst_horizon_days": 540,
  "maximum_implied_price_reconciliation_error": 0.01,
  "required_metric_categories": [
    "industry_or_revenue_driver",
    "margin_or_cash_flow",
    "capital_efficiency_or_valuation"
  ],
  "allowed_units": [
    "percent",
    "basis_points",
    "usd",
    "usd_millions",
    "per_share_usd",
    "ratio",
    "multiple",
    "units"
  ],
  "allowed_driver_units": [
    "usd_millions",
    "units_millions",
    "installed_base_units",
    "subscribers_millions",
    "capacity_units",
    "other_documented_units"
  ],
  "allowed_source_types": [
    "company_filing",
    "company_guidance",
    "earnings_transcript",
    "consensus_dataset",
    "market_price",
    "industry_dataset",
    "regulatory_filing",
    "calculation_input"
  ],
  "allowed_implied_methods": [
    "reverse_dcf",
    "reverse_multiple",
    "reverse_unit_economics",
    "reverse_segment_sum_of_parts"
  ],
  "allowed_valuation_methods": [
    "dcf",
    "pe",
    "ev_ebitda",
    "sum_of_parts"
  ],
  "minimum_thesis_pillars": 2,
  "minimum_risks": 2,
  "minimum_contrary_evidence": 1,
  "minimum_revenue_drivers": 2,
  "minimum_sensitivity_cases": 1,
  "maximum_driver_sensitivity_shock_percent": 50.0,
  "maximum_initial_weight_percent": 2.0,
  "maximum_target_weight_percent": 5.0,
  "maximum_single_name_weight_percent": 7.5,
  "maximum_earnings_event_weight_percent": 2.0,
  "minimum_reward_to_risk": 1.5,
  "require_price_implied_chain": true,
  "require_consensus_chain": true,
  "require_falsification": true,
  "require_bear_base_bull": true,
  "require_driver_based_earnings_model": true,
  "require_cash_flow_bridge": true,
  "require_incremental_roic": true,
  "buy_requires_positive_expected_return": true,
  "score_may_gate_recommendation": false,
  "score_may_size_position": false,
  "execution_authorized": false,
  "promotion_authorized": false
}
