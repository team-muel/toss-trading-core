{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "semantic_type",
    "reporting_currency",
    "unit",
    "value",
    "formula_version",
    "components",
    "content_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "accounting-nav-basis@1"
    },
    "semantic_type": {
      "const": "ACCOUNTING_NAV"
    },
    "reporting_currency": {
      "type": "string"
    },
    "unit": {
      "const": "MONEY"
    },
    "value": {
      "type": "string"
    },
    "formula_version": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "field_id",
          "kind",
          "native_amount",
          "native_currency",
          "fx_to_reporting",
          "amount_reporting",
          "included_in_field",
          "inclusion_evidence_id",
          "treatment"
        ]
      }
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
