{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feature_definition.schema.json",
  "title": "Phase 11 Feature Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["feature_id", "namespace", "name", "version", "input_fields", "lookback", "horizon", "transformation", "missing_policy", "quality_policy"],
  "properties": {
    "feature_id": {"type": "string", "minLength": 1},
    "namespace": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "input_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "lookback": {"type": "string", "minLength": 1},
    "horizon": {"type": "string", "minLength": 1},
    "transformation": {"type": "string", "minLength": 1},
    "missing_policy": {"const": "MISSING_HISTORY"},
    "quality_policy": {"const": "REQUIRE_VALID"}
  }
}
