{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["diagnostics_id", "diagnostic_type", "signal_id", "signal_version", "signal_run_ids", "universe_manifest_ids", "evaluated_at", "formula_version", "parameter_set_id", "code_revision", "input_hash", "metrics"],
  "properties": {
    "diagnostics_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "diagnostic_type": {"enum": ["CROSS_SECTIONAL", "IC_DECAY", "TIME_SERIES"]},
    "signal_id": {"type": "string", "minLength": 1},
    "signal_version": {"type": "string", "minLength": 1},
    "signal_run_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "universe_manifest_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "formula_version": {"type": "string", "minLength": 1},
    "parameter_set_id": {"type": "string", "minLength": 1},
    "code_revision": {"type": "string", "pattern": "^git:[0-9a-f]{7,40}$"},
    "input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "metrics": {"type": "object", "minProperties": 1}
  }
}
