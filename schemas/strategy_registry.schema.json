{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy_registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["strategies", "transitions", "registry_hash"],
  "properties": {
    "strategies": {"type": "array", "items": {"$ref": "#/$defs/strategy"}},
    "transitions": {"type": "array", "items": {"$ref": "#/$defs/transition"}},
    "registry_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "strategy": {"type": "object", "additionalProperties": false,
      "required": ["strategy_id", "version", "name", "economic_thesis", "investable_universe_key", "signal_keys", "forecast_combination_key", "pricing_model_key", "risk_model_key", "portfolio_policy_key", "execution_policy_key", "benchmark", "budget", "supported_horizon", "currency", "allowed_runtime_modes", "effective_from", "effective_to", "status"],
      "properties": {
        "strategy_id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}, "economic_thesis": {"type": "string", "minLength": 1},
        "investable_universe_key": {"type": "string", "minLength": 1},
        "signal_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "forecast_combination_key": {"type": "string", "minLength": 1},
        "pricing_model_key": {"type": "string", "minLength": 1}, "risk_model_key": {"type": "string", "minLength": 1},
        "portfolio_policy_key": {"type": "string", "minLength": 1}, "execution_policy_key": {"type": "string", "minLength": 1},
        "benchmark": {"type": "string", "minLength": 1}, "budget": {"$ref": "#/$defs/budget"},
        "supported_horizon": {"enum": [21, 63, 126, 252]}, "currency": {"const": "USD"},
        "allowed_runtime_modes": {"type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["RESEARCH", "PAPER", "SHADOW", "LIVE"]}},
        "effective_from": {"type": "string", "format": "date-time"}, "effective_to": {"type": "string", "format": "date-time"},
        "status": {"enum": ["RESEARCH", "CANDIDATE", "PAPER", "SHADOW", "LIVE", "DEGRADED", "SUSPENDED", "RETIRED"]}
      }},
    "budget": {"type": "object", "additionalProperties": false,
      "required": ["capital_fraction", "risk_fraction", "max_gross_leverage", "max_turnover"],
      "properties": {"capital_fraction": {"type": "string"}, "risk_fraction": {"type": "string"},
        "max_gross_leverage": {"type": "string"}, "max_turnover": {"type": "string"}}},
    "transition": {"type": "object", "additionalProperties": false,
      "required": ["strategy_key", "from_status", "to_status", "effective_at", "reason", "evidence_ids"],
      "properties": {
        "strategy_key": {"type": "string", "minLength": 1},
        "from_status": {"enum": ["RESEARCH", "CANDIDATE", "PAPER", "SHADOW", "LIVE", "DEGRADED", "SUSPENDED", "RETIRED"]},
        "to_status": {"enum": ["RESEARCH", "CANDIDATE", "PAPER", "SHADOW", "LIVE", "DEGRADED", "SUSPENDED", "RETIRED"]},
        "effective_at": {"type": "string", "format": "date-time"}, "reason": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }}
  }
}
