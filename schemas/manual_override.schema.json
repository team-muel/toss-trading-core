{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_type", "event_version", "override_id", "decision_id", "original_action", "override_action", "reason", "requested_by", "approved_by", "created_at", "expires_at"],
  "properties": {
    "event_type": {"const": "MANUAL_OVERRIDE"},
    "event_version": {"const": 1},
    "override_id": {"type": "string", "pattern": "^override-[0-9a-f]{64}$"},
    "decision_id": {"type": "string", "minLength": 1},
    "original_action": {"enum": ["ALLOW", "REDUCE", "BLOCK", "ABSTAIN", "DEFER"]},
    "override_action": {"enum": ["BLOCK", "DEFER", "LIQUIDITY_RESERVE", "EMERGENCY_LIQUIDATION"]},
    "reason": {"type": "string", "minLength": 1},
    "requested_by": {"type": "string", "minLength": 1},
    "approved_by": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
