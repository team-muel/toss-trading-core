{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "risk_decision_id", "state", "exposure_multiplier", "reason_codes",
    "runtime_run_id", "portfolio_target_id", "portfolio_target_hash",
    "policy_version", "as_of_utc", "evidence_ids", "content_hash"
  ],
  "properties": {
    "risk_decision_id": {"type": "string", "pattern": "^risk-[0-9a-f]{64}$"},
    "state": {"enum": ["ALLOW", "REDUCE", "BLOCK", "ABSTAIN", "DEFER"]},
    "exposure_multiplier": {"type": "string", "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$"},
    "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "runtime_run_id": {"type": "string", "minLength": 1},
    "portfolio_target_id": {"type": "string", "minLength": 1},
    "portfolio_target_hash": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "as_of_utc": {"type": "string", "format": "date-time"},
    "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
