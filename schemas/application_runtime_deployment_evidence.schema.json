{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss-trading.invalid/schemas/application_runtime_deployment_evidence.schema.json",
  "title": "Future separately approved ApplicationRuntime deployment evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_sha", "image_digest", "manifest_hash", "project", "resources", "iam_policy_export_hash", "api_state_hash", "runtime_mode", "live_trading_enabled", "migration_versions", "evidence_store_identity", "backup_restore", "observability_config_hash", "scheduler_inventory_hash", "observed_at", "actor", "approval_reference"],
  "properties": {
    "schema_version": {"const": "canonical-application-runtime-deployment-evidence@1"},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "manifest_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "project": {"$ref": "#/$defs/observedResource"},
    "resources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observedResource"}},
    "iam_policy_export_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "api_state_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "runtime_mode": {"const": "READ_ONLY"},
    "live_trading_enabled": {"const": false},
    "migration_versions": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
    "evidence_store_identity": {"$ref": "#/$defs/observedResource"},
    "backup_restore": {
      "type": "object", "additionalProperties": false,
      "required": ["backup_resource", "snapshot_id", "restore_test_reference", "verified_at"],
      "properties": {"backup_resource": {"$ref": "#/$defs/observedResource"}, "snapshot_id": {"type": "string", "minLength": 1}, "restore_test_reference": {"type": "string", "minLength": 1}, "verified_at": {"type": "string", "format": "date-time"}}
    },
    "observability_config_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "scheduler_inventory_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "observed_at": {"type": "string", "format": "date-time"},
    "actor": {"type": "string", "minLength": 1},
    "approval_reference": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "observedResource": {
      "type": "object", "additionalProperties": false,
      "required": ["resource_type", "resource_id", "project_id", "observed_at", "source_reference"],
      "properties": {
        "resource_type": {"type": "string", "minLength": 1}, "resource_id": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1}, "observed_at": {"type": "string", "format": "date-time"},
        "source_reference": {"type": "string", "minLength": 1}
      }
    }
  }
}
