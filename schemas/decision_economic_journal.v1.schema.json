{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "as_of", "information_cutoff", "assessment_horizon_end", "mandate_key", "mandate_version", "benchmark_key", "benchmark_version", "objective", "reporting_currency", "risk_budget_version", "risk_aversion_policy_version", "state_snapshot_ids", "pricing_lineage_ids", "forecast_lineage_ids", "risk_lineage_ids", "target_lineage_ids", "decision_lineage_ids", "calculation_lineage_ids", "return_metrics", "risk_snapshot_id", "risk_values", "risk_contribution_type", "risk_contributions", "raw_target", "constrained_target", "executable_target", "risk_decision_id", "risk_decision_state", "risk_reason_codes", "policy_versions", "parameter_versions", "model_versions", "code_revision", "decision_id", "content_hash"],
  "properties": {
    "schema_version": {"const": "decision-economic-journal@1"},
    "run_id": {"type": "string"}, "as_of": {"type": "string", "format": "date-time"},
    "information_cutoff": {"type": "string", "format": "date-time"},
    "assessment_horizon_end": {"type": "string", "format": "date-time"},
    "mandate_key": {"type": "string"}, "mandate_version": {"type": "string"},
    "benchmark_key": {"type": "string"}, "benchmark_version": {"type": "string"},
    "objective": {"enum": ["ABSOLUTE_WEALTH", "BENCHMARK_RELATIVE", "MIXED"]}, "reporting_currency": {"type": "string"},
    "risk_budget_version": {"type": "string"}, "risk_aversion_policy_version": {"type": "string"},
    "state_snapshot_ids": {"type": "object", "required": ["MARKET", "COMPANY", "PORTFOLIO", "SYSTEM"]},
    "pricing_lineage_ids": {"$ref": "#/$defs/ids"}, "forecast_lineage_ids": {"$ref": "#/$defs/ids"},
    "risk_lineage_ids": {"$ref": "#/$defs/ids"}, "target_lineage_ids": {"$ref": "#/$defs/ids"},
    "decision_lineage_ids": {"$ref": "#/$defs/ids"}, "calculation_lineage_ids": {"$ref": "#/$defs/ids"},
    "return_metrics": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/return_metric"}},
    "risk_snapshot_id": {"type": "string"}, "risk_values": {"$ref": "#/$defs/decimal_map"},
    "risk_contribution_type": {"enum": ["VARIANCE", "VOLATILITY"]}, "risk_contributions": {"$ref": "#/$defs/decimal_map"},
    "raw_target": {"$ref": "#/$defs/target"}, "constrained_target": {"$ref": "#/$defs/target"},
    "executable_target": {"$ref": "#/$defs/target"}, "risk_decision_id": {"type": "string"},
    "risk_decision_state": {"enum": ["ALLOW", "REDUCE", "BLOCK", "ABSTAIN", "DEFER"]},
    "risk_reason_codes": {"type": "array", "items": {"type": "string"}},
    "policy_versions": {"$ref": "#/$defs/text_map"}, "parameter_versions": {"$ref": "#/$defs/text_map"},
    "model_versions": {"$ref": "#/$defs/text_map"}, "code_revision": {"type": "string"},
    "decision_id": {"type": "string", "pattern": "^decision-[0-9a-f]{64}$"},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "decimal_map": {"type": "object", "additionalProperties": {"type": "string"}},
    "text_map": {"type": "object", "additionalProperties": {"type": "string"}},
    "target": {"type": "object", "additionalProperties": false, "required": ["instruments", "weights", "stage", "reason_codes"], "properties": {"instruments": {"type": "array", "items": {"type": "string"}}, "weights": {"type": "array", "items": {"type": "string"}}, "stage": {"type": "string"}, "reason_codes": {"type": "array", "items": {"type": "string"}}}},
    "return_metric": {"type": "object", "additionalProperties": false, "required": ["semantic_type", "status", "value", "currency_basis", "forecast_horizon", "unit", "formula_version", "model_version"], "properties": {"semantic_type": {"enum": ["PRICING_BASELINE_RETURN", "FORECAST_TOTAL_RETURN_GROSS", "FORECAST_TOTAL_RETURN_NET", "MODEL_RELATIVE_ALPHA", "EXPECTED_BENCHMARK_ACTIVE_RETURN", "REALIZED_ACTIVE_RETURN", "REGRESSION_ALPHA"]}, "status": {"enum": ["AVAILABLE", "NOT_APPLICABLE", "NOT_MATURED"]}, "value": {"type": ["string", "null"]}, "currency_basis": {"enum": ["LOCAL", "BASE", "HEDGED"]}, "forecast_horizon": {"enum": [21, 63, 126, 252]}, "unit": {"enum": ["TOTAL_RETURN", "EXCESS_RETURN", "ACTIVE_RETURN", "REGRESSION_INTERCEPT"]}, "formula_version": {"type": "string"}, "model_version": {"type": "string"}}}
  }
}
