{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["signal_run_id", "signal_id", "signal_version", "semantic_type", "as_of", "information_cutoff", "values", "quality_status", "coverage", "source_feature_manifest_ids", "history_feature_manifest_ids", "universe_manifest_id", "formula_version", "parameter_set_id", "code_revision", "validity", "output_hash"],
  "properties": {
    "signal_run_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signal_id": {"type": "string", "minLength": 1},
    "signal_version": {"type": "string", "minLength": 1},
    "semantic_type": {"const": "SIGNAL_VALUE"},
    "as_of": {"type": "string", "format": "date-time"},
    "information_cutoff": {"type": "string", "format": "date-time"},
    "values": {"type": "object", "minProperties": 1, "additionalProperties": {"type": ["string", "null"]}},
    "quality_status": {"enum": ["VALID", "ESTIMATED"]},
    "coverage": {"type": "string"},
    "source_feature_manifest_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "history_feature_manifest_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "universe_manifest_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "formula_version": {"type": "string", "minLength": 1},
    "parameter_set_id": {"type": "string", "minLength": 1},
    "code_revision": {"type": "string", "pattern": "^git:[0-9a-f]{7,40}$"},
    "validity": {"$ref": "decision_horizon.schema.json"},
    "output_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
