{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["instrument_id", "asset_class", "horizon", "components", "gross_expected_return", "expected_transaction_cost", "expected_tax_drag", "expected_fx_cost", "net_expected_return", "lower_bound", "upper_bound", "confidence", "quality_status", "as_of"],
  "properties": {
    "instrument_id": {"type": "string", "minLength": 1},
    "asset_class": {"enum": ["EQUITY", "EQUITY_ETF", "BOND_ETF", "CASH", "COMMODITY_ETF"]},
    "horizon": {"enum": [21, 63, 126, 252]},
    "components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/component"}},
    "gross_expected_return": {"type": "string"}, "expected_transaction_cost": {"type": "string"},
    "expected_tax_drag": {"type": "string"}, "expected_fx_cost": {"type": "string"},
    "net_expected_return": {"type": "string"}, "lower_bound": {"type": "string"},
    "upper_bound": {"type": "string"}, "confidence": {"type": "string"},
    "quality_status": {"type": "string"}, "as_of": {"type": "string", "format": "date-time"}
  },
  "$defs": {"component": {"type": "object", "additionalProperties": false,
    "required": ["component_name", "point_estimate", "uncertainty", "confidence", "input_features", "horizon"],
    "properties": {"component_name": {"type": "string", "minLength": 1}, "point_estimate": {"type": "string"},
      "uncertainty": {"type": "string"}, "confidence": {"type": "string"},
      "input_features": {"type": "array", "minItems": 1, "items": {"type": "string"}},
      "horizon": {"enum": [21, 63, 126, 252]}}}}
}
