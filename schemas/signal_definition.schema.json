{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["signal_id", "version", "name", "economic_rationale", "source_feature_ids", "transform_rule", "ranking_rule", "normalization_rule", "neutralization_rule", "directionality", "signal_type", "validity", "universe_id", "currency", "minimum_coverage", "minimum_history", "missing_policy", "outlier_policy", "expected_turnover", "cost_sensitivity", "formula_version", "parameter_set_id"],
  "properties": {
    "signal_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
    "version": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "economic_rationale": {"type": "string", "minLength": 1},
    "source_feature_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "transform_rule": {"type": "string", "minLength": 1},
    "ranking_rule": {"type": "string", "minLength": 1},
    "normalization_rule": {"type": "string", "minLength": 1},
    "neutralization_rule": {"type": "string", "minLength": 1},
    "directionality": {"enum": ["POSITIVE", "NEGATIVE"]},
    "signal_type": {"enum": ["CROSS_SECTIONAL", "TIME_SERIES"]},
    "validity": {"$ref": "decision_horizon.schema.json"},
    "universe_id": {"type": "string", "minLength": 1},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "minimum_coverage": {"type": "string"},
    "minimum_history": {"type": "integer", "minimum": 1},
    "missing_policy": {"type": "string", "minLength": 1},
    "outlier_policy": {"type": "string", "minLength": 1},
    "expected_turnover": {"type": "string"},
    "cost_sensitivity": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "formula_version": {"type": "string", "minLength": 1},
    "parameter_set_id": {"type": "string", "minLength": 1}
  }
}
