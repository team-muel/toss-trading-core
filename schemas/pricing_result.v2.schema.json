{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pricing_result.v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "instrument_id",
    "horizon",
    "lower_bound",
    "upper_bound",
    "model_name",
    "model_key",
    "factor_loadings",
    "estimation_uncertainty",
    "quality_status",
    "as_of",
    "validity",
    "output_hash",
    "schema_version",
    "pricing_baseline_return"
  ],
  "properties": {
    "instrument_id": {
      "type": "string",
      "minLength": 1
    },
    "horizon": {
      "enum": [
        21,
        63,
        126,
        252
      ]
    },
    "lower_bound": {
      "type": "string"
    },
    "upper_bound": {
      "type": "string"
    },
    "model_name": {
      "type": "string",
      "minLength": 1
    },
    "model_key": {
      "type": "string",
      "pattern": "^.+@.+$"
    },
    "factor_loadings": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "estimation_uncertainty": {
      "type": "string"
    },
    "quality_status": {
      "enum": [
        "VALID",
        "ESTIMATED"
      ]
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "validity": {
      "$ref": "decision_horizon.schema.json"
    },
    "output_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "schema_version": {
      "const": "pricing-result@2"
    },
    "pricing_baseline_return": {
      "$ref": "economic_value.schema.json"
    }
  }
}
