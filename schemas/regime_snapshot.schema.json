{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regime_snapshot.schema.json",
  "title": "Regime Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "regime_id", "source_state_id", "model_spec_id", "model_key",
    "as_of", "information_cutoff", "output_semantics", "state_probabilities",
    "entropy", "confidence", "input_evidence_ids", "code_revision"
  ],
  "properties": {
    "schema_version": {"const": "regime-snapshot-v1"},
    "regime_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_state_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_spec_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_key": {"type": "string", "minLength": 3},
    "as_of": {"type": "string", "format": "date-time"},
    "information_cutoff": {"type": "string", "format": "date-time"},
    "output_semantics": {
      "enum": ["FILTERED_CAUSAL", "SMOOTHED_RETROSPECTIVE"]
    },
    "state_probabilities": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state_id", "probability"],
        "properties": {
          "state_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "probability": {"type": "string"}
        }
      }
    },
    "entropy": {"type": "string"},
    "confidence": {"type": "string"},
    "input_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "code_revision": {
      "type": "string",
      "pattern": "^git:[0-9a-f]{7,40}$"
    }
  }
}
