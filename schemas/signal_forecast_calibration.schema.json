{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["forecast_calibration_id", "signal_run_id", "signal_id", "signal_version", "universe_manifest_id", "as_of", "information_cutoff", "training_signal_run_ids", "validation_signal_run_ids", "selected_mapping", "candidate_oos_mae", "oos_rmse", "oos_calibration_curve", "regime_bucket_stability", "cost_floor", "prior_return", "cost_floor_shrunk_count", "coverage", "formula_version", "parameter_set_id", "code_revision", "components"],
  "properties": {
    "forecast_calibration_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signal_run_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signal_id": {"type": "string", "minLength": 1},
    "signal_version": {"type": "string", "minLength": 1},
    "universe_manifest_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "as_of": {"type": "string", "format": "date-time"},
    "information_cutoff": {"type": "string", "format": "date-time"},
    "training_signal_run_ids": {"type": "array", "minItems": 1, "uniqueItems": true},
    "validation_signal_run_ids": {"type": "array", "minItems": 1, "uniqueItems": true},
    "selected_mapping": {"enum": ["LINEAR", "NONLINEAR_QUADRATIC", "MONOTONIC"]},
    "candidate_oos_mae": {"type": "object", "minProperties": 3},
    "oos_rmse": {"type": "string"}, "oos_calibration_curve": {"type": "object", "minProperties": 1},
    "regime_bucket_stability": {"type": "object"}, "cost_floor": {"type": "string"},
    "prior_return": {"type": "string"}, "cost_floor_shrunk_count": {"type": "integer"},
    "coverage": {"type": "string"}, "formula_version": {"type": "string", "minLength": 1},
    "parameter_set_id": {"type": "string", "minLength": 1},
    "code_revision": {"type": "string", "pattern": "^git:[0-9a-f]{7,40}$"},
    "components": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/component"}}
  },
  "$defs": {"component": {"type": "object", "additionalProperties": false,
    "required": ["semantic_type", "point_estimate", "lower_bound", "upper_bound", "uncertainty", "confidence", "currency", "unit", "horizon", "valid_until", "model_version"],
    "properties": {"semantic_type": {"const": "signal_forecast_return_component"},
      "point_estimate": {"type": "string"}, "lower_bound": {"type": "string"},
      "upper_bound": {"type": "string"}, "uncertainty": {"type": "string"},
      "confidence": {"type": "string"}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
      "unit": {"const": "DECIMAL_RETURN"}, "horizon": {"enum": [21, 63, 126, 252]},
      "valid_until": {"type": "string", "format": "date-time"}, "model_version": {"type": "string"}}}}
}
