{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "state_snapshot.schema.json",
  "title": "Phase 12 State Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["state_id", "state_type", "as_of", "components", "confidence", "quality_status", "freshness", "input_feature_ids", "policy_version", "code_revision", "operational_state", "risk_multiplier", "regime_label"],
  "properties": {
    "state_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state_type": {"enum": ["MARKET", "COMPANY", "PORTFOLIO", "SYSTEM"]},
    "as_of": {"type": "string", "format": "date-time"},
    "components": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "confidence", "quality_status", "freshness_seconds", "input_feature_ids"],
        "properties": {
          "value": {},
          "confidence": {"type": "string"},
          "quality_status": {"enum": ["VALID", "STALE", "MISSING", "CONFLICT", "PRIMARY_PENDING", "VENDOR_DELAY", "ESTIMATED", "MANUAL", "BLOCKED", "QUARANTINED"]},
          "freshness_seconds": {"type": "integer", "minimum": 0},
          "input_feature_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "confidence": {"type": "string"},
    "quality_status": {"enum": ["VALID", "STALE", "MISSING", "CONFLICT", "PRIMARY_PENDING", "VENDOR_DELAY", "ESTIMATED", "MANUAL", "BLOCKED", "QUARANTINED"]},
    "freshness": {"type": "integer", "minimum": 0},
    "input_feature_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "policy_version": {"type": "string", "minLength": 1},
    "code_revision": {"type": "string", "pattern": "^git:[0-9a-f]{7,40}$"},
    "operational_state": {"enum": ["NORMAL", "CAUTION", "REDUCED_RISK", "NO_NEW_TRADES", "HALTED"]},
    "risk_multiplier": {"type": "string"},
    "regime_label": {"type": ["string", "null"]}
  }
}
