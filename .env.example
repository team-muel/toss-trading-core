TOSS_BROKER_BASE_URL=https://openapi.tossinvest.com
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT_SEQ=
TOSS_API_ENV=local

# GCP Secret Manager runner mode stores secret names here, not secret values.
GCP_PROJECT_ID=
TOSS_CLIENT_ID_SECRET=toss-client-id
TOSS_CLIENT_SECRET_SECRET=toss-client-secret
TOSS_ACCOUNT_SEQ_SECRET=toss-account-seq
TOSS_API_ENV_SECRET=toss-api-env
TOSS_BROKER_BASE_URL_SECRET=toss-broker-base-url

# Research digest delivery. Gmail password/app-password is never used.
RESEARCH_EMAIL_ENABLED=0
RESEARCH_EMAIL_SENDER=your-address@gmail.com
RESEARCH_EMAIL_RECIPIENT=your-address@gmail.com
RESEARCH_DASHBOARD_URL=
RESEARCH_INTERPRETATION_ENABLED=1
RESEARCH_INTERPRETATION_LOCATION=global
RESEARCH_INTERPRETATION_MODEL=gemini-3.1-flash-lite
GMAIL_OAUTH_CLIENT_ID_SECRET=toss-research-gmail-oauth-client-id
GMAIL_OAUTH_CLIENT_SECRET_SECRET=toss-research-gmail-oauth-client-secret
GMAIL_OAUTH_REFRESH_TOKEN_SECRET=toss-research-gmail-oauth-refresh-token

# Research-only Naver Search HUB datafield (alpha/datafields/naver_sentiment.py).
# Decision input only; never execution truth. Leave blank unless authoring KOR alphas.
NAVER_HUB_KEY_ID=
NAVER_HUB_KEY=
