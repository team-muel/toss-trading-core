{
  "rule": [
    {
      "action": {
        "type": "Delete"
      },
      "condition": {
        "daysSinceNoncurrentTime": 90,
        "isLive": false
      }
    },
    {
      "action": {
        "type": "Delete"
      },
      "condition": {
        "age": 30,
        "isLive": true,
        "matchesPrefix": ["research/runs/daily-"]
      }
    },
    {
      "action": {
        "type": "Delete"
      },
      "condition": {
        "age": 365,
        "isLive": true,
        "matchesPrefix": ["research/runs/weekly-"]
      }
    },
    {
      "action": {
        "type": "Delete"
      },
      "condition": {
        "age": 365,
        "isLive": true,
        "matchesPrefix": ["research/reports/daily-"]
      }
    },
    {
      "action": {
        "type": "Delete"
      },
      "condition": {
        "age": 730,
        "isLive": true,
        "matchesPrefix": [
          "research/reports/weekly-",
          "research/status/weekly-"
        ]
      }
    },
    {
      "action": {
        "type": "Delete"
      },
      "condition": {
        "age": 90,
        "isLive": true,
        "matchesPrefix": ["research/status/daily-"]
      }
    }
  ]
}
