[Unit]
Description=Toss research-data automation (%i)
After=network-online.target google-cloud-ops-agent.service
Wants=network-online.target

[Service]
Type=oneshot
User=seoje
Group=seoje
WorkingDirectory=/home/seoje/toss-trading/current
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
CapabilityBoundingSet=
ReadWritePaths=/home/seoje/toss-trading/research-runtime /home/seoje/toss-trading/runtime
EnvironmentFile=-/etc/toss-trading/research.env
Environment=GCP_PROJECT_ID=toss-trading-core-lab
Environment=TOSS_CLIENT_ID_SECRET=toss-client-id
Environment=TOSS_CLIENT_SECRET_SECRET=toss-client-secret
Environment=TOSS_ACCOUNT_SEQ_SECRET=toss-account-seq
Environment=TOSS_API_ENV_SECRET=toss-api-env
Environment=TOSS_BROKER_BASE_URL_SECRET=toss-broker-base-url
Environment=RESEARCH_RUNTIME_ROOT=/home/seoje/toss-trading/research-runtime
Environment=RESEARCH_JSON_LOG_PATH=/home/seoje/toss-trading/research-runtime/research_automation.jsonl
Environment=RESEARCH_LOCK_PATH=/home/seoje/toss-trading/research-runtime/research_automation.lock
Environment=TOSS_API_LOCK_PATH=/home/seoje/toss-trading/runtime/toss_api.lock
Environment=RESEARCH_GCS_URI=gs://toss-trading-core-lab-research-data/research
Environment=RESEARCH_BIGQUERY_DATASET=toss_research_reporting
Environment=RESEARCH_BIGQUERY_TABLE=run_summaries
Environment=CLOUDSDK_CONFIG=/home/seoje/toss-trading/runtime/gcloud
Environment=PATH=/home/seoje/toss-trading/current/.venv/bin:/snap/google-cloud-cli/current/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHON_BIN=/home/seoje/toss-trading/current/.venv/bin/python
ExecStart=/home/seoje/toss-trading/current/scripts/run_research_automation_gcp.sh %i
TimeoutStartSec=4h

[Install]
WantedBy=multi-user.target
